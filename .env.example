# Copy to `.env` and fill in. Everything here is NEXT_PUBLIC_, meaning it is
# compiled into the browser bundle — never put a secret in this file.

# Absolute base URL of this deployment. Feeds canonicals, hreflang, OG tags and
# the sitemap, so a preview must not inherit production's value.
NEXT_PUBLIC_SITE_URL=https://www.welock.in

# ---------------------------------------------------------------------------
# PostHog
# ---------------------------------------------------------------------------
# Leave both blank and analytics is simply off — which is what every local
# checkout should do, so nobody's `npm run dev` lands in production numbers.
#
# KEY is the PROJECT api key, the one that starts `phc_`:
#   PostHog -> Settings -> Project -> Project API key
# It is public by design and belongs in the browser. The other key PostHog
# shows you, `phx_...`, is a PERSONAL api key — it is a secret, it grants
# access to your whole account, and it must never appear in this file.
#
# HOST must match the region the project was created in. Sending EU data to the
# US host does not fail loudly, it just silently records nothing:
#   EU -> https://eu.i.posthog.com
#   US -> https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
